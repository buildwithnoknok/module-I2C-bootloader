# Keep everything LF in the repo and in the working copy.
#
# The firmware sources and Makefiles here are pscp'd from this Windows working
# copy straight to the Pi bench host, and GNU make chokes on a CRLF Makefile.
# Without this, a Windows checkout silently produces build files the Pi cannot
# use. Same rule as the factory-flash repo, for the same reason.
* text=auto eol=lf

# Built images and binaries must never be line-ending translated.
*.bin binary
*.hex binary
*.elf binary
*.pdf binary
*.png binary
